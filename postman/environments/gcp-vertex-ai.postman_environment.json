{
  "name": "Google Vertex AI (OpenAI-compatible)",
  "values": [
    {
      "key": "gcp_project",
      "value": "PASTE-PROJECT-ID",
      "type": "default",
      "enabled": true
    },
    {
      "key": "gcp_region",
      "value": "us-central1",
      "type": "default",
      "enabled": true
    },
    {
      "key": "server",
      "value": "https://{{gcp_region}}-aiplatform.googleapis.com",
      "type": "default",
      "enabled": true
    },
    {
      "key": "api_base",
      "value": "https://{{gcp_region}}-aiplatform.googleapis.com/v1/projects/{{gcp_project}}/locations/{{gcp_region}}/endpoints/openapi",
      "type": "default",
      "enabled": true
    },
    {
      "key": "api_key",
      "value": "PASTE-OUTPUT-OF: gcloud auth print-access-token",
      "type": "secret",
      "enabled": true
    },
    {
      "key": "model",
      "value": "google/PASTE-GEMINI-MODEL-ID",
      "type": "default",
      "enabled": true
    }
  ],
  "_postman_variable_scope": "environment"
}
